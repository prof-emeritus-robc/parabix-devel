<header>
  <generator>test</generator>
  <case>first-letter</case>
  <namespaces>
    <namespace key="-2" case="first-letter">미디어</namespace>
    <namespace key="-1" case="first-letter">특수</namespace>
    <namespace key="0" case="first-letter" />
    <namespace key="1" case="first-letter">토론</namespace>
    <namespace key="2" case="first-letter">사용자</namespace>
    <namespace key="3" case="first-letter">사용자토론</namespace>
    <namespace key="4" case="first-letter">위키책</namespace>
    <namespace key="5" case="first-letter">위키책토론</namespace>
    <namespace key="6" case="first-letter">파일</namespace>
    <namespace key="7" case="first-letter">파일토론</namespace>
    <namespace key="8" case="first-letter">미디어위키</namespace>
    <namespace key="9" case="first-letter">미디어위키토론</namespace>
    <namespace key="10" case="first-letter">틀</namespace>
    <namespace key="11" case="first-letter">틀토론</namespace>
    <namespace key="12" case="first-letter">도움말</namespace>
    <namespace key="13" case="first-letter">도움말토론</namespace>
    <namespace key="14" case="first-letter">분류</namespace>
    <namespace key="15" case="first-letter">분류토론</namespace>
    <namespace key="16" case="first-letter">책</namespace>
    <namespace key="17" case="first-letter">책토론</namespace>
  </namespaces>
</header>
