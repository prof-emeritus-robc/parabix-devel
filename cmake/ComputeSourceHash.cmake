# Computes the source hash of one target (see ParabixSourceHash.cmake).
# Run as a script:
#   cmake -DTARGET=<name> -DINPUTS_FILE=<list> -DOUTPUT=<cpp> -DSTAMP=<file>
#         -DSOURCE_DIR=<dir> -DBINARY_DIR=<dir> -P ComputeSourceHash.cmake
#
# INPUTS_FILE lists one absolute path per line; lines starting with '#' are
# comments.  Each file contributes its path, relative to the source or build
# tree so that the hash does not depend on where the tree is checked out, and
# the SHA-256 of its contents.  OUTPUT is rewritten only when the hash changes.

foreach(VAR TARGET INPUTS_FILE OUTPUT STAMP SOURCE_DIR BINARY_DIR)
    if(NOT DEFINED ${VAR})
        message(FATAL_ERROR "ComputeSourceHash.cmake: ${VAR} is not set")
    endif()
endforeach()

file(STRINGS ${INPUTS_FILE} INPUTS)
set(DIGESTS "")
foreach(INPUT ${INPUTS})
    if(INPUT MATCHES "^#")
        continue()
    endif()
    string(FIND "${INPUT}" "${SOURCE_DIR}/" IN_SOURCE)
    string(FIND "${INPUT}" "${BINARY_DIR}/" IN_BINARY)
    if(IN_SOURCE EQUAL 0)
        file(RELATIVE_PATH NAME ${SOURCE_DIR} ${INPUT})
    elseif(IN_BINARY EQUAL 0)
        file(RELATIVE_PATH NAME ${BINARY_DIR} ${INPUT})
        set(NAME "<build>/${NAME}")
    else()
        set(NAME ${INPUT})
    endif()
    if(EXISTS ${INPUT})
        file(SHA256 ${INPUT} DIGEST)
    else()
        set(DIGEST "missing")
    endif()
    string(APPEND DIGESTS "${NAME} ${DIGEST}\n")
endforeach()
string(SHA256 HASH "${DIGESTS}")

string(MAKE_C_IDENTIFIER ${TARGET} ID)
set(CONTENT "// Generated by cmake/ComputeSourceHash.cmake: do not edit.
// SHA-256 of the sources and headers of ${TARGET} and of every Parabix
// module it depends on, together with the build configuration.

extern \"C\" __attribute__((used, visibility(\"default\")))
const char parabix_srchash_${ID}[] = \"${HASH}\";
")

set(CHANGED TRUE)
if(EXISTS ${OUTPUT})
    file(READ ${OUTPUT} OLD)
    if(OLD STREQUAL CONTENT)
        set(CHANGED FALSE)
    endif()
endif()
if(CHANGED)
    file(WRITE ${OUTPUT} "${CONTENT}")
endif()
file(TOUCH ${STAMP})
