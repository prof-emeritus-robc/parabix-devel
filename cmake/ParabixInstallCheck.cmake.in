# make installcheck: runs the tests of the build (CTestTestfile.cmake) on
# the installed tools.  A directory of links with the names the tests use
# (wc -> <prefix>/bin/pwc) stands in for <build>/bin, and the tests of
# tools not installed are left out.
#
#   cmake [-DPREFIX=<prefix>] [-DCTEST_ARGS="-j4;-R;grep"] -P <build>/ParabixInstallCheck.cmake

cmake_minimum_required(VERSION 3.14)

if(NOT PREFIX)
    set(PREFIX "@CMAKE_INSTALL_PREFIX@")
endif()
set(BUILD_BIN "@PROJECT_BINARY_DIR@/bin")
set(WORK "@PROJECT_BINARY_DIR@/installcheck")
set(RECORDS "${PREFIX}/@PARABIX_RECORD_DIR@")

if(NOT EXISTS "${RECORDS}/runtime.txt")
    message(FATAL_ERROR "No Parabix installation in ${PREFIX}")
endif()

# The links to the installed tools
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}/bin")
file(GLOB TOOL_RECORDS RELATIVE "${RECORDS}" "${RECORDS}/tool-*.txt")
string(REGEX REPLACE "tool-([^;]*)\\.txt" "\\1" INSTALLED "${TOOL_RECORDS}")
foreach(TOOL ${INSTALLED})
    # The program is the file the tool's record lists in bin (its installed
    # name, e.g., pwc for wc, is that of the installation, which may be older)
    file(STRINGS "${RECORDS}/tool-${TOOL}.txt" FILES REGEX "^@CMAKE_INSTALL_BINDIR@/[^/]+$")
    if(NOT FILES)
        message(FATAL_ERROR "No program in the record of ${TOOL}: ${RECORDS}/tool-${TOOL}.txt")
    endif()
    list(GET FILES 0 PROGRAM)
    file(CREATE_LINK "${PREFIX}/${PROGRAM}" "${WORK}/bin/${TOOL}" SYMBOLIC)
endforeach()

# The tools of the tests given the whole bin directory
set(TOOLS_wc_files_test wc ucount matchprior)
set(TOOLS_normalization_test nfc nfd nfkd)
set(TOOLS_editd_test editd)
set(TOOLS_objcache_test base64 icgrep hexlines)
set(TOOLS_option_registration_test "")

# The tests whose tools are installed, on the links
file(READ "@PROJECT_BINARY_DIR@/CTestTestfile.cmake" TESTFILE)
string(REPLACE ";" "<SEMICOLON>" TESTFILE "${TESTFILE}")
string(REPLACE "\n" ";" LINES "${TESTFILE}")
set(KEPT "")
set(SKIPPED "")
set(OUT "")
string(REGEX REPLACE "([][+.*()^$?|\\\\])" "\\\\\\1" BUILD_BIN_RE "${BUILD_BIN}")
foreach(LINE ${LINES})
    if(LINE MATCHES "^add_test\\(([^ ]+) (.*)\\)$")
        set(TEST ${CMAKE_MATCH_1})
        set(ARGS "${CMAKE_MATCH_2}")
        set(NEEDS "")
        set(KNOWN TRUE)
        if(ARGS MATCHES "\"${BUILD_BIN_RE}\"")
            # given the directory
            if(DEFINED TOOLS_${TEST})
                set(NEEDS ${TOOLS_${TEST}})
            else()
                set(KNOWN FALSE)
            endif()
        endif()
        string(REGEX MATCHALL "${BUILD_BIN_RE}/[A-Za-z0-9_.+-]+" PATHS "${ARGS}")
        foreach(PATH ${PATHS})
            get_filename_component(TOOL "${PATH}" NAME)
            list(APPEND NEEDS ${TOOL})
        endforeach()
        if(NOT PATHS AND NOT ARGS MATCHES "\"${BUILD_BIN_RE}\"")
            set(KNOWN FALSE)    # not a test of the tools
        endif()
        set(MISSING "")
        foreach(TOOL ${NEEDS})
            if(NOT TOOL IN_LIST INSTALLED)
                list(APPEND MISSING ${TOOL})
            endif()
        endforeach()
        if(KNOWN AND NOT MISSING)
            list(APPEND KEPT ${TEST})
            string(REPLACE "${BUILD_BIN}" "${WORK}/bin" LINE "${LINE}")
            list(APPEND OUT "${LINE}")
        else()
            list(APPEND SKIPPED ${TEST})
        endif()
    elseif(LINE MATCHES "^set_tests_properties\\(([^ ]+) ")
        if(CMAKE_MATCH_1 IN_LIST KEPT)
            list(APPEND OUT "${LINE}")
        endif()
    endif()
endforeach()
string(REPLACE ";" "\n" OUT "${OUT}")
string(REPLACE "<SEMICOLON>" ";" OUT "${OUT}")
file(WRITE "${WORK}/CTestTestfile.cmake" "# Generated by make installcheck\n${OUT}\n")

list(LENGTH KEPT KEPT_COUNT)
string(REPLACE ";" " " SKIPPED "${SKIPPED}")
message(STATUS "Testing the tools installed in ${PREFIX}: ${KEPT_COUNT} tests")
message(STATUS "Left out (tools not installed, or not tests of tools): ${SKIPPED}")
execute_process(COMMAND "@CMAKE_CTEST_COMMAND@" --output-on-failure ${CTEST_ARGS}
    WORKING_DIRECTORY "${WORK}" RESULT_VARIABLE RESULT)
if(NOT RESULT EQUAL 0)
    message(FATAL_ERROR "installcheck failed")
endif()
