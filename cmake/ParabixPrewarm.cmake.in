# Fills the system-wide object cache (@PARABIX_SYSTEM_CACHE@) by running
# the installed tools once each, on small inputs, with
# -prewarm-system-object-cache: the kernels they compile are then read by
# every user's tools, after their own cache (~/.parabix/objcache).  Only
# kernels that do not depend on what a run asks for (e.g., a regular
# expression) are of use to other runs.
#
# Run (as the owner of the installation, normally root) when installing for
# all users, and after anything that clears the cache:
#
#   cmake -P <prefix>/@PARABIX_PREWARM_SCRIPT@              all installed tools
#   cmake -DTOOL=<tool> -P <prefix>/@PARABIX_PREWARM_SCRIPT@   one tool
#
# The objects are compiled for the processor of the machine running this,
# so it is run where the tools are used (not where a package is built).
# When the installed library has changed, the cache is first emptied: its
# entries are of the earlier library.

cmake_minimum_required(VERSION 3.14)

set(CACHE_DIR "@PARABIX_SYSTEM_CACHE@")
if(CACHE_DIR STREQUAL "")
    message(STATUS "No system-wide object cache is configured; nothing to prewarm")
    return()
endif()
if(NOT PREFIX)
    # This script is <prefix>/@PARABIX_PREWARM_SCRIPT@
    get_filename_component(PREFIX "${CMAKE_CURRENT_LIST_DIR}/@PARABIX_UNINSTALL_SCRIPT_TO_PREFIX@" ABSOLUTE)
endif()
set(RECORDS "${PREFIX}/@PARABIX_RECORD_DIR@")
if(NOT EXISTS "${RECORDS}/runtime.txt")
    message(FATAL_ERROR "No Parabix installation in ${PREFIX}")
endif()

# A new library: its kernels have new keys, and the old entries would stay
# forever (the system-wide cache does not expire).
file(STRINGS "${RECORDS}/runtime.txt" RUNTIME_FILES)
set(LIBRARY_HASH "")
foreach(REL ${RUNTIME_FILES})
    if(REL MATCHES "^@CMAKE_INSTALL_LIBDIR@/libparabix" AND NOT IS_SYMLINK "${PREFIX}/${REL}")
        file(SHA256 "${PREFIX}/${REL}" LIBRARY_HASH)
    endif()
endforeach()
file(MAKE_DIRECTORY "${CACHE_DIR}")
set(STAMP "${CACHE_DIR}/library.sha256")
set(OLD_HASH "")
if(EXISTS "${STAMP}")
    file(READ "${STAMP}" OLD_HASH)
    string(STRIP "${OLD_HASH}" OLD_HASH)
endif()
if(NOT OLD_HASH STREQUAL LIBRARY_HASH)
    file(GLOB OLD_ENTRIES "${CACHE_DIR}/*.kernel" "${CACHE_DIR}/*.o")
    if(OLD_ENTRIES)
        list(LENGTH OLD_ENTRIES COUNT)
        message(STATUS "Emptying ${CACHE_DIR} (${COUNT} files of an earlier library)")
        file(REMOVE ${OLD_ENTRIES})
    endif()
    file(WRITE "${STAMP}" "${LIBRARY_HASH}\n")
endif()

# Inputs
string(RANDOM LENGTH 8 SUFFIX)
if(DEFINED ENV{TMPDIR})
    set(WORK "$ENV{TMPDIR}/parabix-prewarm-${SUFFIX}")
else()
    set(WORK "/tmp/parabix-prewarm-${SUFFIX}")
endif()
file(MAKE_DIRECTORY "${WORK}")
set(TXT "${WORK}/input.txt")
set(CSV "${WORK}/input.csv")
file(WRITE "${TXT}" "The quick brown fox jumps over the lazy dog.\nÉtude, naïve café; Ελληνικά 漢字\n")
file(WRITE "${CSV}" "name,count\nfox,1\ndog,2\n")

# The runs of each tool: arguments separated by ",", runs by "|".  Tools
# not listed (needing particular inputs) are not run.
set(RUNS_icgrep "-c,fox,${TXT}|-c,-i,\\w+,${TXT}")
set(RUNS_ucount "\\p{L},${TXT}")
set(RUNS_ufilter "\\p{L},${TXT}")
set(RUNS_tconv "Latin-ASCII,${TXT}")
foreach(NAME csvcut csvgrep csv2json)
    set(RUNS_${NAME} "${CSV}")
endforeach()
foreach(NAME wc base64 hexlines gb18030 nfc nfd nfkd u32u16 u32u8 u8u16 x8u16
             tokenizer editd hashdemo matchprior ztf-runs stereo2mono)
    set(RUNS_${NAME} "${TXT}")
endforeach()

if(TOOL)
    set(TOOLS ${TOOL})
else()
    file(GLOB TOOL_RECORDS RELATIVE "${RECORDS}" "${RECORDS}/tool-*.txt")
    string(REGEX REPLACE "tool-([^;]*)\\.txt" "\\1" TOOLS "${TOOL_RECORDS}")
endif()

foreach(T ${TOOLS})
    if(NOT EXISTS "${RECORDS}/tool-${T}.txt")
        message(FATAL_ERROR "${T} is not installed in ${PREFIX}")
    endif()
    if(NOT DEFINED RUNS_${T})
        continue()
    endif()
    if(T STREQUAL "icgrep")
        set(PROGRAM "${PREFIX}/@CMAKE_INSTALL_BINDIR@/icgrep")
    else()
        set(PROGRAM "${PREFIX}/@CMAKE_INSTALL_BINDIR@/px-${T}")
    endif()
    message(STATUS "Prewarming the system-wide object cache: ${T}")
    string(REPLACE "|" ";" RUNS "${RUNS_${T}}")
    foreach(RUN ${RUNS})
        string(REPLACE "," ";" ARGS "${RUN}")
        execute_process(COMMAND "${PROGRAM}" -prewarm-system-object-cache ${ARGS}
            WORKING_DIRECTORY "${WORK}"
            OUTPUT_QUIET ERROR_VARIABLE ERRORS RESULT_VARIABLE RESULT TIMEOUT 600)
        # (icgrep -c exits 1 when nothing matches)
        if(NOT RESULT MATCHES "^[01]$")
            message(WARNING "Prewarming with ${T} failed (${RESULT}): ${ERRORS}")
        endif()
    endforeach()
endforeach()

file(REMOVE_RECURSE "${WORK}")
