<mxfile host="app.diagrams.net" modified="2026-05-13" version="21.0.0">
  <diagram id="bpe-pipeline" name="BPE Pipeline">
    <mxGraphModel dx="1422" dy="762" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- ═══════════════════════════════════════════════════════════
             LEFT  —  Depth-Stratified Pipeline Overview
             ═══════════════════════════════════════════════════════════ -->

        <mxCell id="title1" value="BPE Depth-Stratified Pipeline" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="20" y="15" width="400" height="25" as="geometry"/>
        </mxCell>

        <!-- Inputs -->
        <mxCell id="u21" value="u21  (21×1 BixNum)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="30" y="55" width="160" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="ptb0" value="ptBound  (1×1 bitstream)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="240" y="55" width="170" height="40" as="geometry"/>
        </mxCell>

        <!-- InitialSymIDKernel -->
        <mxCell id="isk" value="InitialSymIDKernel&#xa;BixNumCompiler.EQ + createSel per codepoint" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="128" width="280" height="45" as="geometry"/>
        </mxCell>

        <!-- symID_0 -->
        <mxCell id="sym0" value="symID₀  (16×1 BixNum)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="80" y="210" width="180" height="40" as="geometry"/>
        </mxCell>

        <!-- Depth loop background (dashed box) -->
        <mxCell id="loop_bg" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#555555;strokeWidth=2;dashed=1;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="15" y="280" width="410" height="385" as="geometry"/>
        </mxCell>
        <mxCell id="loop_lbl" value="for each depth  d = 0 … D−1" style="text;html=1;align=left;fontStyle=1;fontSize=11;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="25" y="284" width="280" height="18" as="geometry"/>
        </mxCell>

        <!-- BPEMergePassKernel -->
        <mxCell id="bmpk" value="BPEMergePassKernel_D{d}&#xa;(symID, ptBound) → (newSymID, deleteMask)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="30" y="308" width="375" height="45" as="geometry"/>
        </mxCell>

        <!-- InvertStreamKernel -->
        <mxCell id="inv" value="InvertStreamKernel&#xa;deleteMask → keepMask" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="110" y="388" width="220" height="40" as="geometry"/>
        </mxCell>

        <!-- FilterByMask × 2 -->
        <mxCell id="fbm1" value="FilterByMask&#xa;keepMask × newSymID&#xa;→ compressedSym" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="25" y="462" width="170" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="fbm2" value="FilterByMask  [I1]&#xa;keepMask × ptBound&#xa;→ compressedBound" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="215" y="462" width="185" height="60" as="geometry"/>
        </mxCell>

        <!-- Updated streams (loop body output) -->
        <mxCell id="symnext" value="symID_{d+1}  (16×1)      ptBound_{d+1}  (1×1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="55" y="553" width="330" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="loop_iter_lbl" value="↺  feed back as symID / ptBound for next depth pass" style="text;html=1;align=center;fontStyle=2;fontSize=10;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="25" y="603" width="390" height="18" as="geometry"/>
        </mxCell>

        <!-- finalSymID -->
        <mxCell id="finalsym" value="finalSymID  (16×1 BixNum)&#xa;one compressed slot per output token" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="75" y="695" width="280" height="45" as="geometry"/>
        </mxCell>

        <!-- Pipeline edges -->
        <mxCell id="e_u21_isk"   style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="u21"  target="isk"     parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_isk_sym0"  style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="isk"  target="sym0"    parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_sym0_bmpk" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="sym0" target="bmpk"    parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_ptb0_bmpk" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="ptb0" target="bmpk"    parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="e_bmpk_inv"  value="deleteMask" style="edgeStyle=orthogonalEdgeStyle;fontSize=10;" edge="1" source="bmpk" target="inv"  parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_bmpk_fbm1" value="newSymID"   style="edgeStyle=orthogonalEdgeStyle;fontSize=10;exitX=0;exitY=1;exitDx=0;exitDy=0;" edge="1" source="bmpk" target="fbm1" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="e_inv_fbm1"  value="keepMask" style="edgeStyle=orthogonalEdgeStyle;fontSize=10;" edge="1" source="inv" target="fbm1" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_inv_fbm2"  value="keepMask" style="edgeStyle=orthogonalEdgeStyle;fontSize=10;" edge="1" source="inv" target="fbm2" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- ptBound also feeds fbm2 directly (one of its two inputs) -->
        <mxCell id="e_ptb0_fbm2" value="ptBound" style="edgeStyle=orthogonalEdgeStyle;fontSize=10;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" source="ptb0" target="fbm2" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="435" y="75"/>
              <mxPoint x="435" y="492"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="e_fbm1_next" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="fbm1" target="symnext" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_fbm2_next" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="fbm2" target="symnext" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_next_final" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="symnext" target="finalsym" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- ═══════════════════════════════════════════════════════════
             RIGHT  —  BPEMergePassKernel Internals (if/scope tree)
             ═══════════════════════════════════════════════════════════ -->

        <mxCell id="title2" value="BPEMergePassKernel — if/scope tree" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="455" y="15" width="420" height="25" as="geometry"/>
        </mxCell>

        <!-- Kernel inputs -->
        <mxCell id="k_in" value="symID (16×1)  +  ptBound (1×1)&#xa;LookAhead(1) binding on both inputs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="520" y="55" width="290" height="40" as="geometry"/>
        </mxCell>

        <!-- LookAhead(1) -->
        <mxCell id="k_la" value="createLookahead(bit, 1)  on all 16 symID bits  +  ptBound&#xa;→ rightBits[0..15],  nextPtBound" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="498" y="130" width="340" height="40" as="geometry"/>
        </mxCell>

        <!-- canMerge -->
        <mxCell id="k_cm" value="canMerge = NOT(nextPtBound)&#xa;merges cannot cross pre-token boundaries" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="498" y="205" width="340" height="40" as="geometry"/>
        </mxCell>

        <!-- Outer if(canMerge) dashed scope -->
        <mxCell id="outer_bg" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fef9ec;strokeColor=#d6b656;strokeWidth=2;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="458" y="270" width="420" height="355" as="geometry"/>
        </mxCell>
        <mxCell id="outer_lbl" value="if(canMerge)  ← outer scope  (linebreak_kernel pattern)" style="text;html=1;align=left;fontStyle=1;fontSize=11;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="468" y="274" width="400" height="18" as="geometry"/>
        </mxCell>

        <!-- leftMatch (in outer scope) -->
        <mxCell id="k_lm" value="leftMatch = AND over all symBits[i] == leftID[i]&#xa;(bit-by-bit equality check in mergeScope)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="472" y="298" width="392" height="40" as="geometry"/>
        </mxCell>

        <!-- Inner if(leftMatch) dashed scope -->
        <mxCell id="inner_bg" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0fff0;strokeColor=#82b366;strokeWidth=2;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="466" y="360" width="402" height="250" as="geometry"/>
        </mxCell>
        <mxCell id="inner_lbl" value="if(leftMatch)  ← inner scope  (per rule, skips right-match when left misses)" style="text;html=1;align=left;fontStyle=1;fontSize=11;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="476" y="364" width="385" height="18" as="geometry"/>
        </mxCell>

        <!-- rightMatch (in inner scope) -->
        <mxCell id="k_rm" value="rightMatch = AND over all rightBits[i] == rightID[i]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="480" y="390" width="375" height="35" as="geometry"/>
        </mxCell>

        <!-- fires -->
        <mxCell id="k_fires" value="fires = rightMatch  &amp;  NOT(alreadyMatched)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="480" y="440" width="375" height="35" as="geometry"/>
        </mxCell>

        <!-- alreadyMatched (I3) -->
        <mxCell id="k_am" value="alreadyMatched |= fires    [I3: first-match priority — mirrors sequential break]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="480" y="490" width="375" height="35" as="geometry"/>
        </mxCell>

        <!-- mergeAt + desiredBits -->
        <mxCell id="k_db" value="mergeAt |= fires&#xa;desiredBits[i] = fires ? mergedID_bit_i : desiredBits[i]&#xa;(initialized to symBits, so non-fired positions stay correct)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="480" y="540" width="375" height="55" as="geometry"/>
        </mxCell>

        <!-- Conflict resolution (I2) — back in outer pb scope -->
        <mxCell id="k_cr" value="finalFires = mergeAt  &amp;  NOT( Advance(mergeAt, 1) )&#xa;[I2: left-priority — sees union of ALL rule fires before suppression]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="468" y="648" width="408" height="40" as="geometry"/>
        </mxCell>

        <!-- Outputs -->
        <mxCell id="k_out1" value="newSymID[i] =&#xa;finalFires ? desiredBits[i] : symBits[i]&#xa;(16-stream mux)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="455" y="720" width="195" height="55" as="geometry"/>
        </mxCell>

        <mxCell id="k_out2" value="deleteMask =&#xa;Advance(finalFires, 1)&#xa;(right-side position removed)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="670" y="720" width="205" height="55" as="geometry"/>
        </mxCell>

        <!-- Kernel edges -->
        <mxCell id="ke1" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="k_in"    target="k_la"   parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ke2" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="k_la"    target="k_cm"   parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ke3" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="k_cm"    target="k_lm"   parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ke4" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="k_lm"    target="k_rm"   parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ke5" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="k_rm"    target="k_fires" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ke6" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="k_fires" target="k_am"   parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ke7" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="k_am"    target="k_db"   parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ke8" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="k_db"    target="k_cr"   parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ke9" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="k_cr"    target="k_out1" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ke10" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="k_cr"   target="k_out2" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- ═══════════════════════════════════════════════════════════
             FAR RIGHT  —  Legend + Invariants + Depth Formula
             ═══════════════════════════════════════════════════════════ -->

        <!-- Legend box -->
        <mxCell id="leg_bg" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="905" y="15" width="255" height="230" as="geometry"/>
        </mxCell>
        <mxCell id="leg_title" value="Legend" style="text;html=1;align=center;fontStyle=1;fontSize=13;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="905" y="20" width="255" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="l1" value="StreamSet (data stream)" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="915" y="48" width="235" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="l2" value="Pablo Kernel call" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="915" y="88" width="235" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="l3" value="Pablo expression / computation" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="915" y="128" width="235" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="l4" value="Scope body / FilterByMask" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="915" y="168" width="235" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="l5" value="Conflict resolution / final output" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="915" y="208" width="235" height="30" as="geometry"/>
        </mxCell>

        <!-- Invariants box -->
        <mxCell id="inv_bg" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="905" y="258" width="255" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="inv_title" value="Correctness Invariants" style="text;html=1;align=center;fontStyle=1;fontSize=12;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="905" y="263" width="255" height="18" as="geometry"/>
        </mxCell>
        <mxCell id="n1" value="I1  ptBound compressed alongside symID&#xa;     every depth → positions stay aligned" style="text;html=1;align=left;fontSize=11;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="910" y="286" width="245" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n2" value="I2  Conflict resolution after ALL rule scopes&#xa;     → left-priority, sees union of fires" style="text;html=1;align=left;fontSize=11;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="910" y="328" width="245" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n3" value="I3  alreadyMatched masks later rules&#xa;     → first-match priority (mirrors break)" style="text;html=1;align=left;fontSize=11;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="910" y="370" width="245" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="I4  Kernel name encodes depth d&#xa;     → prevents cross-depth cache hits" style="text;html=1;align=left;fontSize=11;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="910" y="412" width="245" height="38" as="geometry"/>
        </mxCell>

        <!-- Depth assignment formula box -->
        <mxCell id="depth_bg" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="905" y="470" width="255" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="depth_title" value="Depth Assignment  (O(N) single pass)" style="text;html=1;align=center;fontStyle=1;fontSize=12;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="905" y="475" width="255" height="18" as="geometry"/>
        </mxCell>
        <mxCell id="depth_formula" value="depth[AB] = 1 + max(depth[A], depth[B])&#xa;&#xa;BPE training rank order guarantees A and B&#xa;are assigned before AB → single O(N) pass,&#xa;no fixed-point iteration needed." style="text;html=1;align=left;fontSize=11;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="910" y="498" width="245" height="105" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
