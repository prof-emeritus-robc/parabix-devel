<?xml version="1.0" encoding="UTF-8"?>
<!--
  tokenizertest.xml - Simple test for tokenizer pretokenizer functionality

  Test format:
  <tokenizertest>
    <inputdata id="test_name">
      raw text input to tokenize
    </inputdata>

    <tokenizercase inputdata="test_name"
             pretokenizer="uax29|whitespace|whitespacesplit|digits|punctuation|simplewordboundaries|bytelevel|chardelimiter|bert|sequence_whitespace_punctuation"
                   expectedcount="N"/>
  </tokenizertest>

  Single shared input: "Hello, world! abc123def, test-case 42."
    - Multiple words with spaces                  (whitespace / uax29 tests)
    - Comma and exclamation punctuation           (punctuation / chardelimiter / bert)
    - Digits mixed with letters: abc123def        (digits test)
    - Hyphen within word: test-case               (word-boundary edge case)
    - Two commas as delimiters                    (chardelimiter gives 3 segments)

-->

<tokenizertest>

  <!-- Shared input for all tests -->
  <inputdata id="test_input">
Hello, world! abc123def, test-case 42.
  </inputdata>

  <inputdata id="test_input2">
Hello, world! abc123def, shouldn't test-case 42.
  </inputdata>

  <!-- ========== PRETOKENIZER TESTS ========== -->

  <!-- UAX29: Unicode word boundaries, isolated behavior (default)
       Hello | , | [sp] | world | ! | [sp] | abc123def | , | [sp] | shouldn't | [sp] | test | - | case | [sp] | 42 | . -->
  <tokenizercase inputdata="test_input2"
                 pretokenizer="uax29"
                 expectedcount="17"/>

  <!-- simple word boundaries, isolated behavior (default)
       Hello | , | [sp] | world | ! | [sp] | abc123def | , | [sp] | shouldn | ' | t | [sp] | test | - | case | [sp] | 42 | . -->
  <tokenizercase inputdata="test_input2"
                 pretokenizer="simplewordboundaries"
                 expectedcount="19"/>

  <!-- Whitespace: \w++ | [^\w\s]++ pattern, forced removed behavior
       Hello | , | world | ! | abc123def | , | test | - | case | 42 | . -->
  <tokenizercase inputdata="test_input"
                 pretokenizer="whitespace"
                 expectedcount="11"/>

  <!-- WhitespaceSplit: non-space runs, forced removed behavior
       Hello, | world! | abc123def, | test-case | 42. -->
  <tokenizercase inputdata="test_input"
                 pretokenizer="whitespacesplit"
                 expectedcount="5"/>

  <!-- Punctuation: each punct char or non-punct run, isolated behavior
       Hello | , | [sp]world | ! | [sp]abc123def | , | [sp]test | - | case | [sp]42 | . -->
  <tokenizercase inputdata="test_input"
                 pretokenizer="punctuation"
                 expectedcount="11"/>

  <!-- Digits: digit run | non-digit-non-space run | space run, isolated behavior
       Hello, | [sp] | world! | [sp] | abc | 123 | def, | [sp] | test-case | [sp] | 42 | . -->
  <tokenizercase inputdata="test_input"
                 pretokenizer="digits"
                 expectedcount="8"/>

  <!-- ByteLevel: space/non-space runs, forced removed behavior
       Hello, | world! | abc123def, | test-case | 42. -->
  <tokenizercase inputdata="test_input"
                 pretokenizer="bytelevel"
                 expectedcount="14"/>

  <!-- CharDelimiter: split on ',' (default), forced removed behavior
       Two commas produce 3 segments: Hello | [sp]world! abc123def | [sp]test-case 42. -->
  <tokenizercase inputdata="test_input"
                 pretokenizer="chardelimiter"
                 expectedcount="3"/>

  <!-- BERT: \w++ | [^\w\s]++ pattern, forced removed behavior
       Hello | , | world | ! | abc123def | , | test | - | case | 42 | . -->
  <!-- <tokenizercase inputdata="test_input"
                 pretokenizer="bert"
                 expectedcount="11"/> -->

  <!-- SeqWhitespacePunctuation: \w++ | [^\w\s]++ pattern, forced removed behavior
       Hello | , | world | ! | abc123def | , | test | - | case | 42 | . -->
  <tokenizercase inputdata="test_input"
                 pretokenizer="sequence_whitespace_punctuation"
                 expectedcount="11"/>

  <!-- ========== BEHAVIOR TESTS (all use uax29 pretokenizer) ========== -->

  <!-- Behavior: removed - delete whitespace, exclude space boundaries
       Hello | , | world | ! | abc123def | , | test | - | case | 42 | . -->
  <tokenizercase inputdata="test_input"
                 pretokenizer="uax29"
                 behavior="removed"
                 expectedcount="11"/>

  <!-- Behavior: isolated - spaces appear as their own tokens (same as uax29 default)
       Hello | , | [sp] | world | ! | [sp] | abc123def | , | [sp] | test | - | case | [sp] | 42 | . -->
  <tokenizercase inputdata="test_input"
                 pretokenizer="uax29"
                 behavior="isolated"
                 expectedcount="15"/>

  <!-- Behavior: mergedwithprevious - trailing space merged into preceding token
       Hello | , [sp] | world | ! [sp] | abc123def | , [sp] | test | - | case [sp] | 42 | . -->
  <tokenizercase inputdata="test_input"
                 pretokenizer="uax29"
                 behavior="mergedwithprevious"
                 expectedcount="11"/>

  <!-- Behavior: mergedwithnext - leading space merged into following token
       Hello | , | [sp]world | ! | [sp]abc123def | , | [sp]test | - | case | [sp]42 | . -->
  <tokenizercase inputdata="test_input"
                 pretokenizer="uax29"
                 behavior="mergedwithnext"
                 expectedcount="11"/>

  <!-- Behavior: contiguous - punct attached to adjacent alphanumeric, spaces isolated
       Hello, | [sp] | world! | [sp] | abc123def, | [sp] | test- | case | [sp] | 42. -->
  <tokenizercase inputdata="test_input"
                 pretokenizer="uax29"
                 behavior="contiguous"
                 expectedcount="10"/>

</tokenizertest>
