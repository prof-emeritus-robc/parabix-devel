<?xml version="1.0" encoding="UTF-8"?>
<!--
  tokenizertest.xml - Simple test for tokenizer pretokenizer functionality
  
  Test format:
  <tokenizertest>
    <inputdata id="test_name">
      raw text input to tokenize
    </inputdata>
    
    <tokenizercase inputdata="test_name" 
             pretokenizer="uax29|whitespace|whitespacesplit|digits|punctuation|simplewordboundaries|bytelevel|chardelimiter|bert|sequence_whitespace_punctuation"
                   expectedcount="N"/>
  </tokenizertest>
-->

<tokenizertest>

  <!-- ========== PRETOKENIZER TESTS - ONE PER MODE ========== -->

  <!-- UAX29: Unicode word boundaries (default) -->
  <inputdata id="simple_words">
hello world test
  </inputdata>
  <tokenizercase inputdata="simple_words" 
                 pretokenizer="uax29"
                 expectedcount="5"/>

  <!-- Whitespace: Split on space characters -->
  <inputdata id="white_space">
hello there this
  </inputdata>
  <tokenizercase inputdata="white_space" 
                 pretokenizer="whitespace" 
                 expectedcount="3"/>

  <!-- WhitespaceSplit: Keep punctuation attached to words -->
  <inputdata id="wss_text">
hello world
  </inputdata>
  <tokenizercase inputdata="wss_text" 
                 pretokenizer="whitespacesplit" 
                 expectedcount="2"/>

  <!-- Punctuation: Split on punctuation characters -->
  <inputdata id="punct_text">
hello, world!
  </inputdata>
  <tokenizercase inputdata="punct_text" 
                 pretokenizer="punctuation" 
                 expectedcount="4"/>

  <!-- Digits: Split on digit sequences -->
  <inputdata id="digit_text">
abc123def
  </inputdata>
  <tokenizercase inputdata="digit_text" 
                 pretokenizer="digits" 
                 expectedcount="3"/>

  <!-- SimpleWordBoundaries: Based on Unicode alphanumeric -->
  <inputdata id="simple_test">
hello world
  </inputdata>
  <tokenizercase inputdata="simple_test"
                 pretokenizer="simplewordboundaries"
                 expectedcount="2"/>

  <!-- ByteLevel: Split on whitespace with byte remapping -->
  <!-- <inputdata id="byte_text">
hello world
  </inputdata>
  <tokenizercase inputdata="byte_text"
                 pretokenizer="bytelevel"
                 expectedcount="2"/> -->

  <!-- CharDelimiter: Split on specific character delimiter -->
  <!-- <inputdata id="char_delim_text">
hello world
  </inputdata>
  <tokenizercase inputdata="char_delim_text"
                 pretokenizer="chardelimiter"
                 expectedcount="2"/> -->

  <!-- BERT: Separates punctuation and words -->
  <!-- <inputdata id="bert_text">
hello, world!
  </inputdata>
  <tokenizercase inputdata="bert_text"
                 pretokenizer="bert"
                 expectedcount="3"/> -->

  <!-- SeqWhitespacePunctuation: Whitespace + Punctuation combined -->
  <inputdata id="seq_text">
hello, world!
  </inputdata>
  <tokenizercase inputdata="seq_text"
                 pretokenizer="sequence_whitespace_punctuation"
                 expectedcount="4"/>

  <!-- ========== BEHAVIOR TESTS - ONE PER MODE ========== -->
  <!-- All behavior tests use UAX29 pretokenizer (respects behavior flag) -->

  <inputdata id="behavior_test">
hello world
  </inputdata>

  <!-- Behavior: removed - exclude whitespace -->
  <tokenizercase inputdata="behavior_test" 
                 pretokenizer="uax29"
                 behavior="removed"
                 expectedcount="2"/>

  <!-- Behavior: isolated - add space boundaries -->
  <tokenizercase inputdata="behavior_test"
                 pretokenizer="uax29"
                 behavior="isolated"
                 expectedcount="3"/>

  <!-- Behavior: mergedwithprevious - attach space to previous word -->
  <tokenizercase inputdata="behavior_test"
                 pretokenizer="uax29"
                 behavior="mergedwithprevious"
                 expectedcount="2"/>

  <!-- Behavior: mergedwithnext - attach space to next word -->
  <tokenizercase inputdata="behavior_test"
                 pretokenizer="uax29"
                 behavior="mergedwithnext"
                 expectedcount="2"/>

  <!-- Behavior: contiguous - keep punctuation with words -->
  <inputdata id="contiguous_test">
hello, world
  </inputdata>
  <tokenizercase inputdata="contiguous_test"
                 pretokenizer="uax29"
                 behavior="contiguous"
                 expectedcount="3"/>

</tokenizertest>
