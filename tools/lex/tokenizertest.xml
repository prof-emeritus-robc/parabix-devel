<?xml version="1.0" encoding="UTF-8"?>
<!--
  tokenizertest.xml - Simple test for tokenizer pretokenizer functionality

  Test format:
  <tokenizertest>
    <inputdata id="test_name">
      raw text input to tokenize
    </inputdata>

    <tokenizercase inputdata="test_name"
             pretokenizer="uax29|whitespace|whitespacesplit|digits|punctuation|simplewordboundaries|bytelevel|chardelimiter|bert|sequence_whitespace_punctuation"
                   expectedcount="N"/>
  </tokenizertest>

  Input: "Hello, world! abc123def, test-case 42. مرحبا بالعالم، یہ ایک ٹیسٹ ہے۔ 你好世界，这是一个测试。 안녕하세요 세계, 이것은 테스트입니다。"
    - Mixed scripts: Latin, Arabic/Urdu, CJK (Chinese), Korean (Hangul)
    - ASCII punctuation: , ! . -     Arabic punctuation: ، ۔     Fullwidth: ， 。
    - Digits mixed with letters: abc123def
    - Contraction with apostrophe: shouldn't (in test_input2 only)
    - Hyphen within word: test-case (UAX29 splits; apostrophe in contractions does not)
    - Three ASCII commas as delimiters (chardelimiter gives 4 segments)

-->

<tokenizertest>

  <!-- Shared input for all tests -->
  <inputdata id="test_input">
Hello, world! abc123def, test-case 42. مرحبا بالعالم، یہ ایک ٹیسٹ ہے۔ 你好世界，这是一个测试。 안녕하세요 세계, 이것은 테스트입니다。
  </inputdata>

  <inputdata id="test_input2">
Hello, world! abc123def, shouldn't test-case 42. مرحبا بالعالم، یہ ایک ٹیسٹ ہے۔ 你好世界，这是一个测试。 안녕하세요 세계, 이것은 테스트입니다。
  </inputdata>

  <!-- ========== PRETOKENIZER TESTS ========== -->

  <!-- UAX29: Unicode word boundaries, isolated behavior (default)
       ASCII/Arabic/Korean words as units; each CJK ideograph is its own token.
       shouldn't kept together (MidNumLet apostrophe); test-case split (hyphen treated as boundary).
       Hello | , | [sp] | world | ! | [sp] | abc123def | , | [sp] | shouldn't | [sp] |
       test | - | case | [sp] | 42 | . | [sp] | مرحبا | [sp] | بالعالم | ، | [sp] |
       یہ | [sp] | ایک | [sp] | ٹیسٹ | [sp] | ہے | ۔ | [sp] |
       你 | 好 | 世 | 界 | ، | 这 | 是 | 一 | 个 | 测 | 试 | 。 | [sp] |
       안녕하세요 | [sp] | 세계 | , | [sp] | 이것은 | [sp] | 테스트입니다 | 。 -->
  <tokenizercase inputdata="test_input2"
                 pretokenizer="uax29"
                 expectedcount="54"/>

  <!-- simplewordboundaries: like UAX29 but CJK chars grouped and contractions split.
       shouldn | ' | t (apostrophe breaks contraction); 你好世界 | 这是一个测试 (CJK grouped).
       Hello | , | [sp] | world | ! | [sp] | abc123def | , | [sp] |
       shouldn | ' | t | [sp] | test | - | case | [sp] | 42 | . | [sp] |
       مرحبا | [sp] | بالعالم | ، | [sp] | یہ | [sp] | ایک | [sp] | ٹیسٹ | [sp] | ہے | ۔ | [sp] |
       你好世界 | ، | 这是一个测试 | 。 | [sp] |
       안녕하세요 | [sp] | 세계 | , | [sp] | 이것은 | [sp] | 테스트입니다 | 。 -->
  <tokenizercase inputdata="test_input2"
                 pretokenizer="simplewordboundaries"
                 expectedcount="48"/>

  <!-- Whitespace: \w++ | [^\w\s]++ pattern, forced removed behavior.
       CJK chars are \w and stay grouped; Arabic/Korean words grouped; all spaces removed.
       Hello | , | world | ! | abc123def | , | test | - | case | 42 | . |
       مرحبا | بالعالم | ، | یہ | ایک | ٹیسٹ | ہے | ۔ |
       你好世界 | ， | 这是一个测试 | 。 | 안녕하세요 | 세계 | , | 이것은 | 테스트입니다 | 。 -->
  <tokenizercase inputdata="test_input"
                 pretokenizer="whitespace"
                 expectedcount="29"/>

  <!-- WhitespaceSplit: non-space runs, forced removed behavior.
       Each space-delimited run becomes one token; internal punctuation stays attached.
       Hello, | world! | abc123def, | test-case | 42. |
       مرحبا | بالعالم، | یہ | ایک | ٹیسٹ | ہے۔ |
       你好世界，这是一个测试。 | 안녕하세요 | 세계, | 이것은 | 테스트입니다。 -->
  <tokenizercase inputdata="test_input"
                 pretokenizer="whitespacesplit"
                 expectedcount="16"/>

  <!-- Punctuation: each punct char or non-punct run, isolated behavior.
       Spaces are included in surrounding non-punct runs (e.g. [sp]world).
       Hello | , | [sp]world | ! | [sp]abc123def | , | [sp]test | - | case | [sp]42 | . |
       [sp]مرحبا[sp]بالعالم | ، | [sp]یہ[sp]ایک[sp]ٹیسٹ[sp]ہے | ۔ |
       [sp]你好世界 | ، | 这是一个测试 | 。 | [sp]안녕하세요[sp]세계 | , | [sp]이것은[sp]테스트입니다 | 。 -->
  <tokenizercase inputdata="test_input"
                 pretokenizer="punctuation"
                 expectedcount="23"/>

  <!-- Digits: each decimal digit is its own token; non-digit runs (including spaces) grouped.
       Hello, world! abc | 1 | 2 | 3 | def, test-case  | 4 | 2 | . [rest of Unicode text] -->
  <tokenizercase inputdata="test_input"
                 pretokenizer="digits"
                 expectedcount="8"/>

  <!-- ByteLevel: GPT-2 byte-level pattern; space before word encoded as Ġ prefix.
       Arabic/Korean words grouped as letter runs; CJK grouped; digits and punct split.
       Hello | , | Ġworld | ! | Ġabc | 123 | def | , | Ġtest | - | case | Ġ | 42 | . |
       Ġمرحبا | Ġبالعالم | ، | Ġیہ | Ġایک | Ġٹیسٹ | Ġہے | ۔ |
       Ġ你好世界 | ، | 这是一个测试 | 。 |
       Ġ안녕하세요 | Ġ세계 | , | Ġ이것은 | Ġ테스트입니다 | 。 -->
  <tokenizercase inputdata="test_input"
                 pretokenizer="bytelevel"
                 expectedcount="32"/>

  <!-- CharDelimiter: split on ',' (ASCII comma only), forced removed behavior.
       Three ASCII commas produce 4 segments (Arabic ، and fullwidth ， are not delimiters).
       Hello | [sp]world![sp]abc123def | [sp]test-case[sp]42.[sp]...[sp]세계 | [sp]이것은[sp]테스트입니다。 -->
  <tokenizercase inputdata="test_input"
                 pretokenizer="chardelimiter"
                 expectedcount="4"/>

  <!-- BERT: \w++ | [^\w\s]++ pattern; whitespace removed before tokenizing.
       Adjacent words (separated only by spaces) may merge after space removal.
       Hello | ,world | !abc123def | ,test | - | case42 | .مرحبابالعالم |
       ،یہایکٹیسٹہے | ۔你好世界 | ، | 这是一个测试 | 。안녕하세요세계 | ,이것은테스트입니다 | 。 -->
  <!-- <tokenizercase inputdata="test_input"
                 pretokenizer="bert"
                 expectedcount="14"/> -->

  <!-- SeqWhitespacePunctuation: \w++ | [^\w\s]++ pattern, forced removed behavior.
       Same as Whitespace but each punctuation char is an individual token (! split from \).
       Hello | , | world | \ | ! | abc123def | , | test | - | case | 42 | . |
       مرحبا | بالعالم | ، | یہ | ایک | ٹیسٹ | ہے | ۔ |
       你好世界 | ، | 这是一个测试 | 。 | 안녕하세요 | 세계 | , | 이것은 | 테스트입니다 | 。 -->
  <tokenizercase inputdata="test_input"
                 pretokenizer="sequence_whitespace_punctuation"
                 expectedcount="29"/>

  <!-- ========== BEHAVIOR TESTS (all use uax29 pretokenizer on test_input) ========== -->

  <!-- Behavior: removed - delete whitespace tokens (15 spaces removed from isolated)
       Hello | , | world | ! | abc123def | , | test | - | case | 42 | . |
       مرحبا | بالعالم | ، | یہ | ایک | ٹیسٹ | ہے | ۔ |
       你 | 好 | 世 | 界 | ، | 这 | 是 | 一 | 个 | 测 | 试 | 。 |
       안녕하세요 | 세계 | , | 이것은 | 테스트입니다 | 。 -->
  <tokenizercase inputdata="test_input"
                 pretokenizer="uax29"
                 behavior="removed"
                 expectedcount="37"/>

  <!-- Behavior: isolated - spaces appear as their own tokens (default UAX29 behavior)
       Hello | , | [sp] | world | ! | [sp] | abc123def | , | [sp] | test | - | case | [sp] |
       42 | . | [sp] | مرحبا | [sp] | بالعالم | ، | [sp] | یہ | [sp] | ایک | [sp] | ٹیسٹ | [sp] |
       ہے | ۔ | [sp] | 你 | 好 | 世 | 界 | ، | 这 | 是 | 一 | 个 | 测 | 试 | 。 | [sp] |
       안녕하세요 | [sp] | 세계 | , | [sp] | 이것은 | [sp] | 테스트입니다 | 。 -->
  <tokenizercase inputdata="test_input"
                 pretokenizer="uax29"
                 behavior="isolated"
                 expectedcount="52"/>

  <!-- Behavior: mergedwithprevious - trailing space merged into preceding token
       Hello | ,[sp] | world | ![sp] | abc123def | ,[sp] | test | - | case[sp] | 42 | . [sp] |
       مرحبا[sp] | بالعالم | ،[sp] | یہ[sp] | ایک[sp] | ٹیسٹ[sp] | ہے | ۔[sp] |
       你 | 好 | 世 | 界 | ، | 这 | 是 | 一 | 个 | 测 | 试 | 。[sp] |
       안녕하세요[sp] | 세계 | ,[sp] | 이것은[sp] | 테스트입니다 | 。 -->
  <tokenizercase inputdata="test_input"
                 pretokenizer="uax29"
                 behavior="mergedwithprevious"
                 expectedcount="37"/>

  <!-- Behavior: mergedwithnext - leading space merged into following token
       Hello | , | [sp]world | ! | [sp]abc123def | , | [sp]test | - | case | [sp]42 | .[sp] |
       [sp]مرحبا | [sp]بالعالم | ، | [sp]یہ | [sp]ایک | [sp]ٹیسٹ | [sp]ہے | ۔ |
       [sp]你 | 好 | 世 | 界 | ، | 这 | 是 | 一 | 个 | 测 | 试 | 。 |
       [sp]안녕하세요 | [sp]세계 | , | [sp]이것은 | [sp]테스트입니다 | 。 -->
  <tokenizercase inputdata="test_input"
                 pretokenizer="uax29"
                 behavior="mergedwithnext"
                 expectedcount="37"/>

  <!-- Behavior: contiguous - punct attached to left neighbor, spaces isolated (11 merges)
       Hello, | [sp] | world! | [sp] | abc123def, | [sp] | test- | case | [sp] | 42. | [sp] |
       مرحبا | [sp] | بالعالم، | [sp] | یہ | [sp] | ایک | [sp] | ٹیسٹ | [sp] | ہے۔ | [sp] |
       你 | 好 | 世 | 界، | 这 | 是 | 一 | 个 | 测 | 试。 | [sp] |
       안녕하세요 | [sp] | 세계, | [sp] | 이것은 | [sp] | 테스트입니다。 -->
  <tokenizercase inputdata="test_input"
                 pretokenizer="uax29"
                 behavior="contiguous"
                 expectedcount="41"/>

</tokenizertest>
